-- 德州扑克用户数据库脚本 (SQLite 版本)
-- 创建日期: 2026-05-14

PRAGMA foreign_keys = ON;

-- 创建用户表
CREATE TABLE IF NOT EXISTS Users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    score INTEGER DEFAULT 1000,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_login_at DATETIME,
    is_active INTEGER DEFAULT 1
);

-- 创建索引
CREATE INDEX IF NOT EXISTS idx_users_username ON Users(username);
CREATE INDEX IF NOT EXISTS idx_users_is_active ON Users(is_active);

-- 创建触发器：自动更新 updated_at
CREATE TRIGGER IF NOT EXISTS trigger_users_updated_at
AFTER UPDATE ON Users
FOR EACH ROW
BEGIN
    UPDATE Users SET updated_at = CURRENT_TIMESTAMP WHERE id = OLD.id;
END;

-- ============================================
-- 存储过程/函数封装 (SQLite 使用 Python/代码层实现)
-- ============================================

-- 辅助函数：用户注册验证
-- 参数：username, password
-- 返回：result (1=成功, 0=失败), message
CREATE VIEW IF NOT EXISTS view_register_check AS
SELECT 
    CASE 
        WHEN LENGTH(username) < 3 THEN '用户名至少需要3个字符'
        WHEN LENGTH(username) > 20 THEN '用户名不能超过20个字符'
        WHEN LENGTH(password) < 6 THEN '密码至少需要6个字符'
        WHEN EXISTS (SELECT 1 FROM Users WHERE username = view_register_check.username) THEN '用户名已存在'
        ELSE 'OK'
    END AS message
FROM (SELECT 'dummy' AS username, 'dummy' AS password) AS tmp;

-- 辅助函数：获取用户信息
-- 参数：user_id
-- 返回：用户信息
CREATE VIEW IF NOT EXISTS view_user_info AS
SELECT 
    id,
    username,
    score,
    created_at,
    last_login_at,
    is_active
FROM Users
WHERE is_active = 1;

-- 辅助函数：获取用户排名
-- 参数：limit 数量
-- 返回：排名列表
CREATE VIEW IF NOT EXISTS view_ranking AS
SELECT 
    ROW_NUMBER() OVER (ORDER BY score DESC) AS rank,
    id,
    username,
    score,
    last_login_at
FROM Users
WHERE is_active = 1;

